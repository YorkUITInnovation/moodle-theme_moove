{{!
    @template theme_moove/need_savy

    Savy chatbot button and container.

    Context variables required for this template:
    * watson-button-icon - URL to the Savy button icon
    * anonymous - Whether this is anonymous mode
}}
<div>
    <img id="savy-btn" src="{{watson-button-icon}}" class="watson-btn" alt="{{#str}}watson_logo, theme_moove{{/str}}">
    <div class="count-container hidden" data-region="count-container"></div>
    <div id="savy-container"></div>
</div>
{{#js}}
    require(['theme_moove/need_savy'], function(mod) {
    mod.init();
    });
{{/js}}

